# Copie este arquivo para .env e preencha os valores.
# Nunca envie o arquivo .env para o GitHub.

PORT=3000
NODE_ENV=development

# Chave da API do TMDB: https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Segredo aleatório para assinar os cookies de sessão (mínimo 32 caracteres).
# Gere com:
# node --input-type=module -e "import { randomBytes } from 'node:crypto'; console.log(randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Dados do projeto Supabase (Project Settings > API).
SUPABASE_URL=
# Prefira a Secret key do projeto. Também aceitamos a chave legada service_role.
# Essa chave é privada e deve existir somente no servidor/Vercel.
SUPABASE_SECRET_KEY=
# Alternativa para projetos que ainda usam a chave legada:
# SUPABASE_SERVICE_ROLE_KEY=
