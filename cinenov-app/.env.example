# Copie para .env e preencha:  cp .env.example .env

# Porta do servidor (padrão: 3000)
PORT=3000

# Chave da API do TMDB (v3). Crie grátis em https://www.themoviedb.org/settings/api
TMDB_API_KEY=cole_sua_chave_aqui

# Segredo que assina a sessão de login. Gere um com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Obrigatório em produção (mínimo 32 caracteres).
JWT_SECRET=troque_por_um_valor_aleatorio_com_pelo_menos_32_caracteres

# Opcional: onde fica o arquivo do banco SQLite (padrão: ./data/cinenov.db)
# DB_PATH=./data/cinenov.db
